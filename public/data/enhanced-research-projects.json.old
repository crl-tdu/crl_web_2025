        "result": "images/thumbnails/2024_M_n.ito_result.png"
      },
      "original_detail_link": "project/2024/2024_M_n.ito_detail.html",
      "original_thumb": "project/2024/img/2024_M_n.ito_thumb.png"
    },
    {
